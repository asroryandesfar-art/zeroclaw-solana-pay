# ZeroClaw Solana Payment Assistant — configuration.
#
# Copy to `.env` and fill in. `.env` is git-ignored and is the ONLY file that
# holds secrets. Nothing here is a private key — this system is non-custodial
# and only ever needs a *receiving* public key.
#
# ─────────────────────────────────────────────────────────────────────────────
# A) Read by the `solpay` binary today
# ─────────────────────────────────────────────────────────────────────────────

# Master switch. `devnet` (default) or `mainnet-beta`.
SOLANA_CLUSTER=devnet

# Safety interlock. Must be exactly `true` to run on mainnet-beta.
# With the default, solpay refuses to start on mainnet.
ALLOW_MAINNET=false

# The merchant's receiving wallet (base58, on-curve PUBLIC key — no private key).
# The value below is a shared DEMO wallet so the demo works out of the box;
# replace it with YOUR OWN wallet for anything real. (If left empty, the demo
# scripts fall back to the same demo wallet.)
MERCHANT_WALLET=9pKSaQGCnfdjFCoHhSAc5mPDDyaBtNeQX2mjFuGNAvmG

# Shown in the customer's wallet and on the QR. Quote values that contain spaces.
STORE_LABEL="ZeroClaw Store"

# Comma-separated token symbols accepted. Supported: USDC (SPL) and SOL (native).
TOKEN_ALLOWLIST=USDC,SOL

# Charge bounds (decimal, in token units). Anti fat-finger / abuse.
MIN_CHARGE=0.01
MAX_CHARGE=1000

# Settlement bar: `confirmed` (default, ~1-2s) or `finalized` (~13s, reorg-proof).
# `processed` is rejected — it can be dropped in a fork.
PAYMENT_COMMITMENT=confirmed

# RPC endpoints. https required (http allowed only for localhost).
# The URL may embed a provider API key — treat the whole value as a secret.
SOLANA_RPC_PRIMARY=https://api.devnet.solana.com
SOLANA_RPC_FALLBACK=

# RPC resilience.
RPC_TIMEOUT_MS=8000
RPC_MAX_RETRIES=3
RPC_BACKOFF_BASE_MS=250

# ─────────────────────────────────────────────────────────────────────────────
# B) Used by the ZeroClaw agent / SOP layer (wired in the agent phase)
# ─────────────────────────────────────────────────────────────────────────────

# Invoice lifetime and verification polling.
INVOICE_TTL_SECONDS=900
POLL_INTERVAL_SECONDS=10
POLL_MAX_ATTEMPTS=90

# WhatsApp (Cloud API mode). Names are referenced from zeroclaw.toml (*_env).
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# LLM provider key for the single intent-extraction step.
LLM_API_KEY=
