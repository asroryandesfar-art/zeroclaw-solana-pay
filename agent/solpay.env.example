# Locked money-path configuration for solpay, read by the ZeroClaw skills.
#
# Copy to ~/.zeroclaw/solpay.env and edit. The skills source THIS file (by a
# $HOME-relative path) because ZeroClaw clears the environment before running a
# skill's shell command — only $HOME survives, so the locked config lives in a
# file, not ambient env vars.
#
# Values are sourced by /bin/sh, so anything with spaces MUST be quoted.
# None of these are secrets — the merchant wallet is a PUBLIC receiving key and
# this assistant is non-custodial (it never holds or signs).

SOLANA_CLUSTER="devnet"                                   # devnet | mainnet-beta
ALLOW_MAINNET="false"                                     # hard interlock; "true" to permit mainnet
MERCHANT_WALLET="REPLACE_WITH_YOUR_PUBLIC_RECEIVING_KEY"  # base58 pubkey
SOLANA_RPC_PRIMARY="https://api.devnet.solana.com"
# SOLANA_RPC_FALLBACK="https://<your-fallback-rpc>"
TOKEN_ALLOWLIST="USDC,SOL"
PAYMENT_COMMITMENT="confirmed"                            # never "processed"
STORE_LABEL="ZeroClaw Store"
